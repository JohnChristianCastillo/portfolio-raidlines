# Copy to backend/.env and fill in. Never commit the real file.
# Register the client at https://www.warcraftlogs.com/api/clients/ with
# "Public Client" UNCHECKED. See _local/wcl_api_registration/how_to_setup.md.
RAIDLINES_WCL_CLIENT_ID=
RAIDLINES_WCL_CLIENT_SECRET=

# Serve recorded fixtures even when the credentials above are set. Useful for UI
# work, since it costs nothing against the hourly point budget.
# RAIDLINES_FORCE_FIXTURES=1
